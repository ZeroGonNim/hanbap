# Instagram API Credentials (Meta Graph API)
# 이 파일에 실제 값을 넣은 후 .env 로 저장하여 사용하세요.

IG_USER_ID=your_instagram_business_account_id
ACCESS_TOKEN=your_meta_graph_api_access_token
FB_PAGE_ID=your_facebook_page_id

# Frontend URL (이미지 접근을 위해 인스타그램 서버가 접근 가능한 주소여야 합니다)
# 예: https://hnabap-promo.vercel.app
PRODUCTION_URL=https://your-deployed-site.com
